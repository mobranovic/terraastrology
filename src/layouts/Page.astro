---
// Inner page: starry header band + content.
import Base from './Base.astro';
import Starfield from '../components/Starfield.astro';
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  hideCta?: boolean;
}
const { title, eyebrow, lede, description, image, noindex, jsonLd, hideCta } = Astro.props;
---
<Base title={title} description={description ?? lede} image={image} noindex={noindex} jsonLd={jsonLd} hideCta={hideCta}>
  <header class="page-hero">
    <Starfield count={70} seed={5} />
    <div class="wrap">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot name="hero" />
    </div>
  </header>
  <slot />
</Base>
