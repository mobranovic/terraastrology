---
// Terra Astrology emblem – the hermit lighting the way with his lantern.
// Image files are generated from brand/emblem-source.jpg by
// `node scripts/make-logo.mjs`.
interface Props { size?: number; class?: string; title?: string; loading?: 'eager' | 'lazy' }
const { size = 44, class: cls, title, loading = 'eager' } = Astro.props;
const src = size <= 48 ? 96 : size <= 128 ? 256 : 512;
---
<img
  class={cls}
  src={`/brand/logo-${src}.webp`}
  srcset={`/brand/logo-96.webp 96w, /brand/logo-192.webp 192w, /brand/logo-256.webp 256w, /brand/logo-512.webp 512w`}
  sizes={`${size}px`}
  width={size}
  height={size}
  alt={title ?? ''}
  loading={loading}
  decoding="async"
/>
