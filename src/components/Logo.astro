---
// Terra Astrology emblem: the Hermit before the full moon, his lantern
// lighting the path. `id` keeps the SVG gradients unique when the logo
// appears more than once on a page.
interface Props { size?: number; id?: string; class?: string; title?: string }
const { size = 40, id = 'logo', class: cls, title } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id={`${id}-c`}><circle cx="32" cy="32" r="32"/></clipPath>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#e6fbef"/>
      <stop offset="0.28" stop-color="#7fdcae" stop-opacity="0.75"/>
      <stop offset="1" stop-color="#62d49c" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id={`${id}-road`} x1="0.2" y1="1" x2="0.8" y2="0">
      <stop offset="0" stop-color="#7fdcae" stop-opacity="0.9"/>
      <stop offset="1" stop-color="#7fdcae" stop-opacity="0.15"/>
    </linearGradient>
  </defs>
  <g clip-path={`url(#${id}-c)`}>
    <rect width="64" height="64" fill="#0f2219"/>
    <!-- moon -->
    <circle cx="35" cy="26" r="17.5" fill="#dde8e0"/>
    <circle cx="41" cy="19" r="3.2" fill="#0f2219" opacity="0.07"/>
    <circle cx="45.5" cy="28" r="2" fill="#0f2219" opacity="0.06"/>
    <circle cx="36" cy="14.5" r="1.4" fill="#0f2219" opacity="0.06"/>
    <!-- hills -->
    <path fill="#1a3d2b" d="M0 45 C5 41 9 43 13 40 C17 37 21 42 27 41 C34 39.5 39 43.5 46 41 C52 39 57 42 64 40 V64 H0Z"/>
    <path fill="#081510" d="M0 51 C12 48.5 26 50.5 36 49.5 C47 48.5 56 50.5 64 49.5 V64 H0Z"/>
    <!-- the lit path, winding to the horizon -->
    <path fill={`url(#${id}-road)`} d="M30 64 C33 59.5 40 56.5 46 54 C50 52.3 52 50.6 52.6 48.6 C53.2 50.8 52.2 53 49.6 55.2 C46 58.2 42.8 60.8 41.6 64 Z"/>
    <!-- staff -->
    <path d="M15.4 10 L13.2 52" stroke="#5b8a70" stroke-width="1.4" stroke-linecap="round"/>
    <!-- hermit -->
    <g fill="#081510">
      <path d="M22 12.6 C25.6 12.8 28.4 16 28.6 20.6 L28.8 25.6 C29.9 26.8 30.9 28.2 31.4 29.8 L39.6 32 C40.3 32.3 40.2 33.3 39.5 33.5 L33 34.3 C34.2 40 35.4 46 37 51.4 C31 52.4 22 52.4 11.8 51.4 C13.8 44 16.2 36 17.6 29.4 C16.6 23 17.6 14.8 22 12.6 Z"/>
      <path d="M32.6 33.8 C35 35.6 36.2 38.8 36 42.2 L33.4 40.8 Z"/>
    </g>
    <!-- faint outline of the back against the night -->
    <path fill="none" stroke="#24503a" stroke-width="0.6" d="M28.6 20.6 C28.4 16 25.6 12.8 22 12.6 C17.6 14.8 16.6 23 17.6 29.4 C16.2 36 13.8 44 11.8 51.4"/>
    <!-- cloak folds -->
    <g fill="none" stroke="#1d4431" stroke-width="0.6" stroke-linecap="round">
      <path d="M21.6 31 C21 39 20.2 45 19.4 51"/>
      <path d="M26.6 33 C27.2 40 28 46 29.2 51.2"/>
    </g>
    <!-- rim light from the lantern -->
    <g fill="none" stroke="#7fdcae" stroke-width="0.55" stroke-linecap="round" opacity="0.8">
      <path d="M33 34.3 C34.2 40 35.4 46 37 51.4"/>
      <path d="M31.4 29.8 L39.4 31.9"/>
      <path d="M33.6 40.9 L36 42.2"/>
    </g>
    <!-- face & beard in the hood -->
    <path fill="#c3d4c9" d="M27.8 19.8 C26.4 21 26 23.6 26.5 25.8 C26.9 27.8 27.6 29.2 28.2 29.8 L28.7 26.6 L28.4 20.6 Z"/>
    <!-- chain, glow, star, lantern -->
    <path d="M39.6 33.2 L44.9 37.8" stroke="#081510" stroke-width="0.6"/>
    <circle cx="45" cy="42.4" r="11" fill={`url(#${id}-glow)`}/>
    <path fill="#f2fff7" d="M45 32.6 C45.5 39.8 46 41.4 53.6 42.4 C46 43.4 45.5 45 45 52.2 C44.5 45 44 43.4 36.4 42.4 C44 41.4 44.5 39.8 45 32.6 Z"/>
    <!-- lantern -->
    <path fill="#081510" d="M43.2 39.4 L45 37.6 L46.8 39.4 Z"/>
    <rect x="43.5" y="39.6" width="3" height="4.6" rx="0.4" fill="#d9f7e6" stroke="#081510" stroke-width="0.6"/>
    <path d="M45 39.6 V44.2" stroke="#081510" stroke-width="0.45"/>
    <path fill="#081510" d="M43.4 44.2 h3.2 l-0.6 0.9 h-2 z"/>
  </g>
</svg>
