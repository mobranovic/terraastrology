---
// Terra Astrology emblem: the Hermit (as on the tarot card) on a cliff under
// the guiding star, raising his lantern to light the way. `id` keeps the SVG gradients unique when the logo
// appears more than once on a page.
interface Props { size?: number; id?: string; class?: string; title?: string }
const { size = 40, id = 'logo', class: cls, title } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id={`${id}-c`}><circle cx="32" cy="32" r="32"/></clipPath>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0a1822"/><stop offset="0.7" stop-color="#12302f"/>
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff4d6"/>
      <stop offset="0.25" stop-color="#f3c96b" stop-opacity="0.75"/>
      <stop offset="1" stop-color="#e0a83a" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id={`${id}-starglow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff1c9" stop-opacity="0.9"/>
      <stop offset="1" stop-color="#f3c96b" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <g clip-path={`url(#${id}-c)`}>
    <rect width="64" height="64" fill={`url(#${id}-sky)`}/>
    <!-- night sky: guiding star with astrological lines -->
    <g fill="#f3dfa8"><circle cx="9" cy="22" r="0.4"/><circle cx="50" cy="12" r="0.45"/><circle cx="56" cy="24" r="0.35"/><circle cx="14" cy="12" r="0.35"/><circle cx="22" cy="5" r="0.3"/><circle cx="47" cy="5.5" r="0.3"/><circle cx="58" cy="33" r="0.3"/></g>
    <g fill="none" stroke="#e9c77a" stroke-width="0.25" opacity="0.45">
      <circle cx="31" cy="10" r="6.5"/><path d="M31 0 V24 M17 10 H47 M24 3 L38 17"/>
    </g>
    <circle cx="31" cy="10" r="5" fill={`url(#${id}-starglow)`}/>
    <polygon fill="#fff3cf" points="31.00,4.80 31.27,9.35 33.02,7.98 31.65,9.73 36.20,10.00 31.65,10.27 33.02,12.02 31.27,10.65 31.00,15.20 30.73,10.65 28.98,12.02 30.35,10.27 25.80,10.00 30.35,9.73 28.98,7.98 30.73,9.35"/>
    <!-- mountains -->
    <path fill="#2a474c" d="M0 44 L5 38 L8 40.5 L14.5 27 L19 36 L22 33 L28 44 V64 H0Z"/>
    <path fill="#d9c3a2" opacity="0.8" d="M14.5 27 L19 36 L17.4 35 L16.2 36.6 L15.4 33.4 L14 34.6 L13.4 31 Z"/>
    <path fill="#d9c3a2" opacity="0.6" d="M22 33 L28 44 L26 42.6 L24.6 43.6 L23 39 Z"/>
    <path fill="#264247" d="M33 52 L40 41.5 L43 44 L50.5 30 L55.5 39 L58.5 36 L64 44 V64 H33Z"/>
    <path fill="#d9c3a2" opacity="0.8" d="M50.5 30 L55.5 39 L53.6 38 L52.4 39.6 L51.6 36 L50 37.4 L49.4 33 Z"/>
    <path fill="#d9c3a2" opacity="0.55" d="M58.5 36 L64 44 L62 43 L60.6 44 L59.4 40 Z"/>
    <!-- cliff -->
    <path fill="#0b1713" d="M0 55.5 C9 53.6 20 53 31 53.4 C37 53.6 41 54.6 43.4 57 L47 64 H0Z"/>
    <path fill="none" stroke="#e9c77a" stroke-width="0.5" opacity="0.55" d="M22 53.2 C30 53.1 37.4 53.7 41.8 55.6"/>
    <!-- lantern light -->
    <circle cx="43.8" cy="29.4" r="13" fill={`url(#${id}-glow)`}/>
    <g stroke="#f6d995" stroke-width="0.35" stroke-linecap="round" opacity="0.6"><path d="M50.20 29.40L55.80 29.40 M49.81 31.59L52.63 32.61 M48.70 33.51L52.99 37.11 M47.00 34.94L48.50 37.54 M44.91 35.70L45.88 41.22 M42.69 35.70L42.17 38.66 M40.60 34.94L37.80 39.79 M38.90 33.51L36.60 35.44 M37.79 31.59L32.52 33.50 M37.40 29.40L34.40 29.40 M37.79 27.21L32.52 25.30 M38.90 25.29L36.60 23.36 M40.60 23.86L37.80 19.01 M42.69 23.10L42.17 20.14 M44.91 23.10L45.88 17.58 M47.00 23.86L48.50 21.26 M48.70 25.29L52.99 21.69 M49.81 27.21L52.63 26.19"/></g>
    <!-- staff with crook -->
    <path fill="none" stroke="#a3824a" stroke-width="1.25" stroke-linecap="round" d="M14.4 56 L16.4 18.6 C16.6 14.2 21.2 13.6 21.6 17 C21.9 19.2 20 20.2 19.2 18.8"/>
    <!-- robe -->
    <path fill="#2b2319" d="M26 15.6 C30.6 14.6 34.6 17.6 35.2 22 C35.5 24.4 35 26.6 34 28.4 L42.4 22.2 C43.2 21.8 43.8 22.8 43.2 23.6 L37.4 30.8 C38 38 39.4 47 41.6 54.4 C35 55.6 22 55.6 12.8 54.6 C14.8 47 16.8 39 18.4 33.6 L16.6 34 L16.4 32.2 L20.2 29.6 C21.8 28.4 22.6 26.8 22.4 24.6 C22 20.6 23 16.6 26 15.6 Z"/>
    <!-- blue inner robe -->
    <path fill="#1d3a40" d="M28.6 38.2 L34.2 38 C34.8 44 35.6 49.4 36.8 55 C34.4 55.4 32 55.5 30 55.4 C29.4 49.6 29 44 28.6 38.2 Z"/>
    <!-- wide hanging sleeve of the raised arm -->
    <path fill="#2b2319" d="M36.2 28.8 L42.8 23.4 C42.4 29 41.6 35 40.6 41.6 C38.6 39 37.4 35.6 36.4 32 Z"/>
    <!-- golden rim light -->
    <g fill="none" stroke="#f0cf86" stroke-width="0.5" stroke-linecap="round" opacity="0.9">
      <path d="M34 28.4 L42.4 22.2"/>
      <path d="M42.8 24 C42.4 29 41.6 35 40.6 41.6"/>
      <path d="M37.6 33 C38.4 40 39.6 47.4 41.6 54.4"/>
      <path d="M26 15.6 C30.6 14.6 34.6 17.6 35.2 22"/>
    </g>
    <path fill="none" stroke="#3d3324" stroke-width="0.5" d="M26 15.6 C23 16.6 22 20.6 22.4 24.6 C22.6 26.8 21.8 28.4 20.2 29.6 M18.4 33.6 C16.8 39 14.8 47 12.8 54.6"/>
    <!-- robe folds -->
    <g fill="none" stroke="#3b3022" stroke-width="0.5" stroke-linecap="round">
      <path d="M22 40 C21 45 20 50 19 54.6"/><path d="M25.6 40.6 C25.4 45.6 25.6 50.6 26 55"/><path d="M37.6 44 C38 47.6 38.6 51 39.4 54.6"/>
    </g>
    <!-- rope belt with tassels -->
    <g fill="none" stroke="#d1b06d" stroke-width="0.55" stroke-linecap="round">
      <path d="M21.6 37.6 C26 38.6 31 38.6 36.8 37.4"/>
      <path d="M27.2 38.4 C27 40.6 26.8 42.6 26.6 44.8 M28.4 38.4 C28.6 40.4 28.6 42.2 28.4 44"/>
    </g>
    <!-- hood opening, bowed face in three-quarter profile -->
    <path fill="#050a08" d="M29 17.8 C32 17.4 34.4 19.6 34.6 22.6 C34.8 25 34 27.2 33 28.6 L29.4 28.6 C28.4 25.6 28 20.8 29 17.8 Z"/>
    <path fill="#e6d4b8" d="M30.6 19.6 C32.4 19.6 33.8 20.8 34 22.6 L35.4 24.4 L34.2 24.9 C34.2 25.8 33.6 26.6 32.8 26.8 L30.4 27 C29.6 24.6 29.6 21.6 30.6 19.6 Z"/>
    <path d="M30.8 21.4 C31.8 21 33 21.2 33.8 21.8" stroke="#f6f1e8" stroke-width="0.7" fill="none" stroke-linecap="round"/>
    <path d="M32.2 22.9 C32.6 23.2 33.1 23.2 33.4 22.9" stroke="#2b2319" stroke-width="0.4" fill="none" stroke-linecap="round"/>
    <!-- long white beard -->
    <path fill="#f1ece2" d="M30 25.2 C31.2 26.4 32.8 26.6 34.2 25.6 C34.8 27.6 34.4 29.6 33.8 31.6 C33.4 33.6 33.6 35.6 32.8 37.8 C32.4 39.2 31.6 40.6 31 42 C30.6 40 29.8 38.6 29.6 36.4 C29.4 34 28.6 31.6 29 29.2 C29.2 27.6 29.4 26.2 30 25.2 Z"/>
    <g fill="none" stroke="#bdb3a0" stroke-width="0.3" stroke-linecap="round"><path d="M31.4 28 C31.2 31 31.4 34.8 31 38.4"/><path d="M33 28 C33 31 32.8 34.2 32.2 37.4"/><path d="M30.2 28.6 C30 31.2 30.2 34 30.2 36.4"/></g>
    <path fill="#f1ece2" d="M29.6 18.8 C28.6 21.4 28.6 25 29.4 28 L30.2 27.6 C29.6 25 29.6 21.6 30.4 19.4 Z" opacity="0.7"/>
    <!-- hands -->
    <path fill="#e6d9c3" d="M42.6 21.4 C43.6 20.8 44.6 21.4 44.6 22.4 C44.6 23.2 43.8 23.6 43.2 23.4 Z"/>
    <circle cx="16.2" cy="32.6" r="1.05" fill="#e6d9c3"/>
    <!-- old lantern -->
    <g>
      <circle cx="43.8" cy="24.4" r="0.8" fill="none" stroke="#0d1a17" stroke-width="0.45"/>
      <path fill="#0d1a17" d="M41.9 26.6 C42 25.6 42.9 25.1 43.8 25.1 C44.7 25.1 45.6 25.6 45.7 26.6 Z"/>
      <rect x="41.5" y="26.5" width="4.6" height="0.75" rx="0.2" fill="#0d1a17"/>
      <rect x="42.1" y="27.2" width="3.4" height="4.6" fill="#ffe8a8"/>
      <path d="M42.1 27.2 V31.8 M45.5 27.2 V31.8" stroke="#0d1a17" stroke-width="0.6"/>
      <path d="M43.8 27.2 V31.8" stroke="#0d1a17" stroke-width="0.25" opacity="0.5"/>
      <path fill="#f3b54a" d="M43.8 28.2 C44.5 29.2 44.6 30.2 43.8 31 C43.1 30.2 43.2 29.2 43.8 28.2 Z"/>
      <path fill="#0d1a17" d="M41.5 31.7 H46.1 L45.4 32.8 H42.2 Z"/>
      <path fill="#0d1a17" d="M43.3 32.8 H44.3 L43.8 33.6 Z"/>
    </g>
  </g>
</svg>
