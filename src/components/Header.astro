---
import { NAV, SITE } from '../lib/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.title} — home`}>
      <Logo size={42} class="mark" />
      <span>Terra <em>Astrology</em></span>
    </a>

    <nav class="nav" aria-label="Main">
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-list">
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <ul id="nav-list">
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="cta"><a class="btn btn-primary" href="/book/">Book a reading</a></li>
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const list = document.getElementById('nav-list')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    list.classList.toggle('open', !open);
  });

  const root = document.documentElement;
  document.querySelector('.theme-toggle')!.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 500 1.3rem/1 var(--font-display);
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .brand em {
    color: var(--accent);
  }
  .mark {
    flex: none;
    color: var(--ink);
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a:not(.btn) {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .nav a:not(.btn):hover,
  .nav a[aria-current='page'] {
    color: var(--accent);
  }
  .nav .cta {
    margin-left: 8px;
  }
  .nav .btn {
    padding: 0.7em 1.1em;
    font-size: 0.88rem;
  }
  .menu-toggle,
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-toggle {
    display: none;
  }
  .theme-toggle .moon { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .sun { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun { display: none; }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon { display: block; }
  }

  @media (max-width: 960px) {
    .bar { gap: 8px; }
    .menu-toggle { display: inline-grid; }
    .nav { order: 3; }
    .nav ul {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 16px 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .nav ul.open { display: flex; }
    .nav a:not(.btn) { padding: 14px 4px; border-bottom: 1px solid var(--line); border-radius: 0; font-size: 1.05rem; }
    .nav .cta { margin: 16px 0 0; }
    .nav .btn { width: 100%; justify-content: center; padding: 1em; }
  }
</style>
