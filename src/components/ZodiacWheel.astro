---
// Decorative zodiac wheel; each glyph links to its sign essay.
import { SIGNS, glyph } from '../lib/zodiac';
interface Props { size?: number; links?: boolean }
const { links = true } = Astro.props;
const R = 150;
const pos = SIGNS.map((s, i) => {
  // Chart orientation: Aries rises on the left (Ascendant) and the signs run counter-clockwise.
  const a = ((180 - (i * 30 + 15)) * Math.PI) / 180;
  return { ...s, x: 200 + Math.cos(a) * R, y: 200 + Math.sin(a) * R };
});
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const r1 = i % 6 === 0 ? 172 : 180;
  return { x1: 200 + Math.cos(a) * r1, y1: 200 + Math.sin(a) * r1, x2: 200 + Math.cos(a) * 186, y2: 200 + Math.sin(a) * 186 };
});
---
<svg class="wheel" viewBox="0 0 400 400" role="img" aria-label="Zodiac wheel">
  <g class="ring" fill="none" stroke="currentColor">
    <circle cx="200" cy="200" r="186" stroke-width="1" />
    <circle cx="200" cy="200" r="172" stroke-width="0.6" opacity="0.6" />
    <circle cx="200" cy="200" r="122" stroke-width="0.6" opacity="0.6" />
    <circle cx="200" cy="200" r="54" stroke-width="0.6" opacity="0.4" />
    {ticks.map((t) => <line {...t} stroke-width="0.6" opacity="0.7" />)}
    {SIGNS.map((_, i) => {
      const a = ((180 - i * 30) * Math.PI) / 180;
      return <line x1={200 + Math.cos(a) * 122} y1={200 + Math.sin(a) * 122} x2={200 + Math.cos(a) * 172} y2={200 + Math.sin(a) * 172} stroke-width="0.6" opacity="0.6" />;
    })}
  </g>
  <g class="spin">
    {/* a grand trine and a square – the classic aspect figures */}
    <polygon points="78,200 261,94 261,306" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.35" />
    <polygon points="114,114 286,114 286,286 114,286" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.25" />
  </g>
  <circle cx="200" cy="200" r="5" class="sun" />
  {pos.map((s) =>
    links ? (
      <a href={`/${s.post}/`} class="sign">
        <title>{s.name}</title>
        <circle cx={s.x} cy={s.y} r="20" class="hit" />
        <text x={s.x} y={s.y} class="glyph">{glyph(s.glyph)}</text>
      </a>
    ) : (
      <text x={s.x} y={s.y} class="glyph sign">{glyph(s.glyph)}</text>
    ),
  )}
</svg>
<style>
  .wheel { width: 100%; height: auto; color: var(--band-accent); overflow: visible; }
  .spin { transform-origin: 200px 200px; animation: spin 240s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .sun { fill: var(--band-accent); }
  text {
    font-size: 22px;
    fill: var(--band-ink);
    text-anchor: middle;
    dominant-baseline: central;
    transition: fill 0.2s;
  }
  .hit { fill: transparent; transition: fill 0.2s; }
  a.sign:hover text, a.sign:focus-visible text { fill: var(--band-accent); }
  a.sign:hover .hit, a.sign:focus-visible .hit { fill: var(--glow); }
  a.sign:focus-visible { outline: none; }
</style>
