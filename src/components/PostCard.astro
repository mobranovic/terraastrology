---
import { mediaUrl } from '../lib/media.mjs';
import { categoryName, formatDate } from '../lib/site';
import { postUrl, type Post } from '../lib/posts';
interface Props { post: Post; large?: boolean }
const { post, large = false } = Astro.props;
const { title, excerpt, image, imageAlt, categories, date } = post.data;
---
<article class:list={['card', { large }]}>
  <a href={postUrl(post)} class="media" tabindex="-1" aria-hidden="true">
    {image ? (
      <img src={mediaUrl(image)} alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <svg class="placeholder" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="0.6"><circle cx="16" cy="16" r="11" /><circle cx="16" cy="16" r="4.5" /><path d="M16 5v22M5 16h22" /></g>
      </svg>
    )}
  </a>
  <div class="body">
    {categories[0] && <p class="cat">{categoryName(categories[0])}</p>}
    <h3><a href={postUrl(post)}>{title}</a></h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <p class="date"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
  </div>
</article>
<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .media {
    display: block;
    aspect-ratio: 16 / 10;
    background: radial-gradient(120% 120% at 70% 10%, var(--night-2), var(--night));
    overflow: hidden;
  }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .media img { transform: scale(1.04); }
  .placeholder { width: 100%; height: 100%; padding: 22%; color: var(--night-gold); opacity: 0.55; }
  .body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
  .cat { font: 600 0.72rem/1 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.7rem; }
  h3 { font-size: 1.35rem; margin: 0 0 0.5rem; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .excerpt {
    font-family: var(--font-text);
    color: var(--muted);
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .date { margin: auto 0 0; font-size: 0.8rem; color: var(--muted); }
  .large h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .large .media { aspect-ratio: auto; flex: 1; min-height: 260px; }
  .large .body { flex: 0 0 auto; }
</style>
