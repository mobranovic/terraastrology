---
// Deterministic star field (same on every build) for dark "night sky" bands.
interface Props { count?: number; seed?: number }
const { count = 90, seed = 7 } = Astro.props;
let s = seed;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: count }, () => ({
  x: rnd() * 100,
  y: rnd() * 100,
  r: rnd() < 0.08 ? 1.6 : rnd() * 0.9 + 0.3,
  o: rnd() * 0.6 + 0.25,
  d: (rnd() * 6 + 3).toFixed(1),
}));
---
<svg class="starfield" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100">
  {stars.map((st) => (
    <circle cx={st.x} cy={st.y} r={st.r / 10} fill="#fff" opacity={st.o} style={`animation-duration:${st.d}s`} />
  ))}
</svg>
<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  circle {
    animation: twinkle ease-in-out infinite alternate;
  }
  circle:nth-child(3n) {
    animation-name: none;
  }
  @keyframes twinkle {
    to { opacity: 0.1; }
  }
</style>
