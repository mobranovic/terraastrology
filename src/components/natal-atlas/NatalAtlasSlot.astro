---
/**
 * Reserved place for Natal Atlas features.
 *
 * Usage:  <NatalAtlasSlot context="home" />   (also "consultation", "sign")
 *
 * While NATAL_ATLAS.enabled is false a tasteful "coming soon" panel is shown.
 * When the integration is ready, render the real widget for `context` below
 * (an iframe, a script embed or an Astro/JS component placed in this folder).
 */
import { NATAL_ATLAS } from '../../lib/site';
import Starfield from '../Starfield.astro';

interface Props {
  context: 'home' | 'consultation' | 'sign' | 'page';
  compact?: boolean;
}
const { context, compact = false } = Astro.props;
const { enabled, features, appUrl } = NATAL_ATLAS;
---
<section class:list={['atlas', { compact }]} data-natal-atlas={context} aria-labelledby={`atlas-${context}`}>
  <Starfield count={compact ? 30 : 70} seed={11} />
  <div class="inner">
    <p class="eyebrow">Natal Atlas</p>
    {enabled ? (
      <>
        <h2 id={`atlas-${context}`}>Explore your chart</h2>
        {/* TODO: mount the Natal Atlas widget for this context here. */}
        <div class="mount" id={`natal-atlas-${context}`} />
        {appUrl && <a class="btn btn-light" href={appUrl}>Open Natal Atlas</a>}
      </>
    ) : (
      <>
        <h2 id={`atlas-${context}`}>Interactive chart tools are on their way</h2>
        <p>
          Selected features of the Natal Atlas app will live here — a quiet place to look at your own
          chart alongside the essays.
        </p>
        {features.length > 0 && (
          <ul>{features.map((f) => <li><strong>{f.title}</strong> — {f.description}</li>)}</ul>
        )}
        {!compact && <a class="btn btn-light" href="/natal-atlas/">What to expect</a>}
      </>
    )}
  </div>
</section>
<style>
  .atlas {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(217 184 92 / 0.18), transparent 60%),
      radial-gradient(120% 140% at 0% 100%, var(--night-2), var(--night));
    color: var(--night-ink);
    padding: clamp(32px, 5vw, 64px);
    border: 1px dashed rgb(217 184 92 / 0.45);
  }
  .inner { position: relative; max-width: 60ch; }
  .eyebrow { color: var(--night-gold); }
  h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  p { color: var(--night-muted); }
  .compact { padding: 28px; }
  .compact h2 { font-size: 1.4rem; }
  .mount { min-height: 240px; }
</style>
