---
import type { Faq } from '../data/faq';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center;
    padding: 20px 0; font: 500 1.15rem/1.35 var(--font-display);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 300 1.6rem/1 var(--font-ui); color: var(--accent); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--accent); }
  p { margin: -4px 0 22px; color: var(--ink-soft); font-family: var(--font-text); font-size: 1.05rem; max-width: 70ch; }
</style>
