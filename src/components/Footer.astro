---
import { SITE } from '../lib/site';
import { SIGNS, glyph } from '../lib/zodiac';
import Starfield from './Starfield.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer deep">
  <Starfield count={60} seed={3} />
  <div class="wrap inner">
    <div class="about">
      <p class="name"><Logo size={56} id="logo-footer" /><span>Terra <em>Astrology</em></span></p>
      <p>{SITE.tagline}. Essays and consultations by {SITE.author}.</p>
      <a class="btn btn-light" href="/book/">Book a reading</a>
    </div>
    <nav aria-label="Footer">
      <h2>Consultations</h2>
      <ul>
        <li><a href="/consultations/natal-chart/">Natal chart reading</a></li>
        <li><a href="/consultations/synastry/">Relationship reading</a></li>
        <li><a href="/consultations/location-astrology/">Location astrology</a></li>
        <li><a href="/consultations/gift/">Gift a reading</a></li>
        <li><a href="/free-forecast/">Free forecast</a></li>
      </ul>
    </nav>
    <nav aria-label="Journal">
      <h2>Journal</h2>
      <ul>
        <li><a href="/sun-signs/">Sun Signs</a></li>
        <li><a href="/12-myths-zodiac/">Myths of the Zodiac</a></li>
        <li><a href="/category/planets/">Planets</a></li>
        <li><a href="/mundane-astrology/">Mundane astrology</a></li>
        <li><a href="/journal/">All essays</a></li>
      </ul>
    </nav>
    <nav aria-label="Site">
      <h2>Terra</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/newsletter/">Newsletter</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap bottom">
    <p class="signs glyph" aria-hidden="true">{SIGNS.map((s) => glyph(s.glyph)).join('  ')}</p>
    <p>© {year} {SITE.title} · Place data © <a href="https://www.geonames.org/">GeoNames</a></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--band);
    color: var(--band-muted);
    padding: 72px 0 28px;
    margin-top: 0;
  }
  .inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 500 1.6rem/1 var(--font-display);
    color: var(--band-ink);
  }
  .name em { color: var(--band-accent); }
  .name :global(svg) { border-radius: 50%; box-shadow: 0 0 0 1px rgb(127 220 174 / 0.35); }
  .about p:not(.name) { max-width: 42ch; }
  h2 {
    font: 600 0.75rem/1 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--band-accent);
    margin-bottom: 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.55rem; }
  a:not(.btn) { color: var(--band-ink); text-decoration: none; }
  a:not(.btn):hover { color: var(--band-accent); }
  .bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.85rem;
  }
  .bottom p { margin: 0; }
  .signs { letter-spacing: 0.3em; color: var(--band-accent); opacity: 0.8; }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
